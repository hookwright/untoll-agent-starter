# Copy to .env. Nothing in this repo reads a keystore or generates a key for you.

# Required by agent/run.ts
UNTOLL_OWNER_KEY=0x
UNTOLL_SESSION_KEY=0x
UNTOLL_DELEGATE_IMPL=0x
UNTOLL_POOL_ID=0x

# Read by mcp/server.ts. The lane is the whole access decision and it never resolves upward:
# absent means read, an unrecognised value is refused, and an owner key present here does not open
# the owner lane. Keep the owner key off the agent host and run the owner lane separately.
# UNTOLL_MCP_MODE=read
# UNTOLL_AGENT_ADDRESS=0x
# UNTOLL_ROUTER=0x

# Optional. Defaults to Robinhood Chain testnet 46630, which is where the contracts below live.
# EIP-7702 needs a chain at the Prague hardfork or later.
# UNTOLL_RPC=https://rpc.testnet.chain.robinhood.com
# UNTOLL_CHAIN_ID=46630
# UNTOLL_CHAIN_NAME=Robinhood Chain testnet
# UNTOLL_PASSES=1

# Optional address overrides, for a fork or a later redeploy. Each defaults to the generated
# deploy record in src/generated/contracts.ts.
# UNTOLL_POOL_MANAGER=0x
# UNTOLL_LAUNCH_HOOK=0x
# UNTOLL_TOKEN_FACTORY=0x
# UNTOLL_LAUNCH_TOKEN_IMPL=0x
# UNTOLL_REPUTATION_REGISTRY=0x
# UNTOLL_POL_MATH=0x
